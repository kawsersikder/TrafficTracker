# ── Environment & secrets ──────────────────────────────────────────
.env
*.env.local
*.env.production

# ── Node ───────────────────────────────────────────────────────────
node_modules/
.dist/
dist/

# ── Python ─────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── Runtime-generated images (captured screenshots & annotations) ──
public/*.png
public/*.jpg
public/*.jpeg

# ── One-time credential / seed scripts (contain real passwords) ────
create_teacher.ts
create_admins.ts
update_photo.ts

# ── Prisma generated client (rebuilt via `npx prisma generate`) ────
node_modules/.prisma/

# ── OS & editor noise ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── Claude Code local config ───────────────────────────────────────
.claude/

# ── Datasets: keep documentation, exclude raw data (too large for git)
dataset/**/raw/
dataset/**/code/

# ── Model weights (regenerate by training; too large for git) ──────
*.pt
*.pth
*.onnx

# ── Training / experiment outputs ──────────────────────────────────
runs/
experiments/out/
experiments/runs/

# ── Overnight-run bookkeeping (regenerated on every run) ───────────
.run_state/
logs/
RUN_PROGRESS.md

# ── Superseded working notes (folded into PROGRESS.md) ─────────────
MORNING_README.md
HANDOVER.md
session_summary.md

# ── Vendored extraction binaries (download as needed) ──────────────
*.exe

# ── Extracted dataset archives (rebuild from the source .rar/.zip) ─
dataset/**/extracted/

# ── Scratch ────────────────────────────────────────────────────────
F:/temp/
temp/
*.tmp

# ── Phase 2/3 run bookkeeping ──────────────────────────────────────
.run_state*/
logs*/
RUN_PROGRESS*.md

# ── Converted YOLO datasets (rebuild via tfpbd_to_yolo.py) ─────────
experiments/out/tfpbd_yolo/
experiments/out/dhakaai_shared_yolo/
